{
  "name": "x-cleaner-ai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "prisma generate && tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "test:integration": "node --env-file=.local/test.env scripts/test-integration.mjs",
    "test:e2e": "playwright test",
    "dev": "vite",
    "dev:server": "tsx --env-file=.env server/main.ts",
    "mcp": "node --env-file-if-exists=.env dist/server/mcp-stdio.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fontsource-variable/geist": "^5.2.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@prisma/client": "^6.19.0",
    "@tanstack/react-query": "^5.90.0",
    "fastify": "^5.6.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.553.0",
    "prisma": "^6.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "4.0.18"
  }
}
